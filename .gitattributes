# Set default behavior to automatically handle line endings
* text=auto

# Enforce LF (Unix) line endings for source code files
*.js text eol=lf
*.jsx text eol=lf
*.cjs text eol=lf
*.json text eol=lf
*.html text eol=lf
*.css text eol=lf
*.cpp text eol=lf
*.h text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf
.githooks/* text eol=lf

# Denotate binary files explicitly
*.pdf binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg text
*.zip binary
*.tar.gz binary

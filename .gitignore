# Root gitignore for the Doto project
# Covers Node.js, React (Vite), and C++ build outputs

# --- Dependency directories ---
node_modules/
jspm_packages/
web_modules/

# --- Build & Output directories ---
dist/
dist-ssr/
build/
out/
bin/
obj/
x64/
Release/
Debug/
target/
.cache/
.vite/
.parcel-cache/
.next/
.nuxt/

# --- Environment & Secret files ---
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env
*.pem
*.key
certs/
secrets*

# --- C++ Compiled outputs & IDEs ---
# Executables
*.exe
*.out
*.app
*.bin

# Object files and libraries
*.o
*.obj
*.a
*.lib
*.so
*.dylib
*.gch

# Debugging files
*.pdb
*.ilk
*.idb
*.suo
*.user

# CMake / CLion / IDE build outputs
cmake-build-*/
.cmake/
CMakeCache.txt
CMakeFiles/
Makefile
cmake_install.cmake

# --- Editor / IDE configurations ---
.vscode/
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.swo
*.swn
.classpath
.project
.settings/
.factorypath
*.sublime-project
*.sublime-workspace

# --- OS generated files ---
.DS_Store
Thumbs.db
desktop.ini
$RECYCLE.BIN/
ehthumbs.db

# --- Log files ---
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# --- Test Coverage & Tool Cache ---
coverage/
.nyc_output/
.eslintcache
.jest/

# --- Temp/Evaluation Files ---
temp_eval.js
dashboard/temp_eval.js


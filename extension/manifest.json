{
  "manifest_version": 3,
  "name": "Olympic Coach AI",
  "version": "1.0",
  "description": "Analyzes algorithmic problem solutions using AI.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "*://*.pbinfo.ro/*",
    "*://codeforces.com/*",
    "http://localhost:3000/*"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://*.pbinfo.ro/*", "*://codeforces.com/*"],
      "css": ["content-styles.css"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
